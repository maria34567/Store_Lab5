@model IEnumerable<Store.Infrastructure.Models.ElectronicsModel>
<!doctype html><html lang="uk"><head><meta charset="utf-8"/><title>Store — Товари</title><style>body{font:16px Arial;margin:3rem auto;max-width:1100px;color:#223}table{border-collapse:collapse;width:100%}td,th{padding:12px;border-bottom:1px solid #ddd;text-align:left}a{color:#1757a8}</style></head><body><h1>Каталог електроніки</h1><p>Перші 100 товарів із бази SQLite</p><table><thead><tr><th>Назва</th><th>Бренд</th><th>Ціна</th><th>Гарантія</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-controller="Products" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td><td>@item.Brand</td><td>@item.Price.ToString("N2") ₴</td><td>@item.WarrantyMonths міс.</td></tr>}</tbody></table></body></html>